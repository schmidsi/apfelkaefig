{
  "$schema": "https://apfelkaefig.com/schema/v1.json",
  "version": 1
  // Image: omit to use the built-in base (built locally on first `akf up`
  // from an embedded Dockerfile; cached as apfelkaefig-base:<hash>), set a
  // registry tag (e.g. "node:22-bookworm"), or point at a custom Dockerfile:
  //   "image": { "dockerfile": ".devcontainer/Dockerfile" }

  // Extra mounts beyond the defaults
  // (workspace + ~/.claude RW + ~/Downloads RO + ~/Desktop RO).
  // Bind by default; type: "volume" uses a named Apple `container` volume,
  // pre-created by `akf up` (use this for state that must stay off the host).
  // "mounts": [
  //   { "source": "${localEnv:HOME}/.config/gh", "target": "/home/node/.config/gh" },
  //   { "type": "volume", "source": "my-cache", "target": "/cache" }
  // ],

  // Env injected at run time. Substitution: ${localEnv:VAR},
  // ${localWorkspaceFolder}, ${localWorkspaceFolderBasename}.
  // "env": {
  //   "TZ": "UTC"
  // },

  // "user": "node",
  // "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // "resources": { "cpus": 2, "memory": "4G" },
  // "command": ["claude", "--dangerously-skip-permissions"],

  // 1Password injection is implicit-on when OP_SERVICE_ACCOUNT_TOKEN is in
  // your env or macOS keychain. Set false to opt out, true to require.
  // "secrets": { "onepassword": true }
}
