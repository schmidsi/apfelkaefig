{
  "version": "0.2.0-dev",
  "tasks": {
    "dev": "deno run -A cli/main.ts",
    "test": "deno test -A",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check cli/main.ts",
    "compile": "deno run --allow-run --allow-read --allow-write scripts/stamp-build.ts && deno compile -A --target aarch64-apple-darwin --include ./templates --include ./image --include ./deno.json --include ./cli/build_info.json --output dist/akf cli/main.ts",
    "gen-schema": "deno run --allow-read --allow-write scripts/gen-schema.ts"
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.9",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.6",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.1"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "exclude": [
      "npm/",
      "dist/"
    ]
  },
  "lint": {
    "exclude": [
      "npm/",
      "dist/",
      "image/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
