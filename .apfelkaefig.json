{
  "$schema": "https://apfelkaefig.com/schema/v1.json",
  "version": 1,
  "tmux": true,
  "image": {
    "dockerfile": ".devcontainer/Dockerfile"
  },
  "plugins": {
    "ssh": {
      "enabled": true,
      "authorizedKey": "${localWorkspaceFolder}/.devcontainer/authorized_keys.pub",
      "port": 2222
    }
  },
  "mounts": [
    {
      "type": "volume",
      "source": "ssh-apfelkaefig-hostkey",
      "target": "/var/lib/akf-ssh"
    },
    {
      "type": "volume",
      "source": "ssh-apfelkaefig-remote",
      "target": "/home/node/.claude/remote"
    }
  ],
  "ports": [
    {
      "hostIp": "127.0.0.1",
      "host": 2222,
      "container": 22,
      "protocol": "tcp"
    }
  ]
}
